{
  "name": "paragraph-flow-repair-shop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "문단 흐름 수리소 — 초등 3~6학년 국어 문단 흐름 학습 앱(정적, 무서버, 무저장)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "test:a11y": "vitest run tests/a11y",
    "test:release": "vitest run --config vitest.release.config.ts",
    "test:e2e": "playwright test",
    "check:lines": "node scripts/check-file-lines.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:run && npm run test:a11y && npm run check:lines && npm run build && npm run test:release && npm run test:e2e"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.48.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.4",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "axe-core": "^4.10.0",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "vitest-axe": "^0.1.0"
  }
}
